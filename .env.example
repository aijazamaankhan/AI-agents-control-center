NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave empty to use the built-in local database started by `npm run dev` (no install needed),
# or point to your own PostgreSQL, e.g. postgresql://agentos:agentos@localhost:5432/agentos
DATABASE_URL=
# Disposable database — integration/E2E tests RESET it on every run.
TEST_DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos_test

AUTH_SECRET=

# 32 random bytes, base64. `npm run setup` generates AUTH_SECRET and ENCRYPTION_KEY for you.
ENCRYPTION_KEY=

# Allow agent endpoints on localhost / private networks for "Test connection" (dev only).
ALLOW_PRIVATE_AGENT_ENDPOINTS=false

REDIS_URL=

INTERNAL_API_SECRET=

# Resend API key (https://resend.com) — enables enquiry / demo-request emails.
EMAIL_PROVIDER_API_KEY=

# Sender, e.g. "AgentOS <onboarding@resend.dev>" (Resend test sender) or your verified domain.
EMAIL_FROM=

# Where website enquiries and demo requests are sent (default: velorexdesign@gmail.com).
INQUIRY_TO_EMAIL=velorexdesign@gmail.com

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

WEBHOOK_SIGNING_SECRET=
