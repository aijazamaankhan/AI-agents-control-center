// AgentOS database schema. Source of truth for table design: docs/DATABASE.md.
// Every tenant-owned table carries organization_id and is indexed on it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model User {
  id              String    @id
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Velorex Studio staff: access to /admin (granted only via `npm run admin:grant`).
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  /// Suspended users can't sign in; their sessions stop working immediately.
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships      Membership[]
  sessions         Session[]
  auditLogs        AuditLog[]
  approvalsDecided Approval[]   @relation("ApprovalDecider")

  @@map("users")
}

model Organization {
  id          String    @id
  name        String
  slug        String    @unique
  industry    String
  companySize String    @map("company_size")
  country     String
  timezone    String
  /// Suspended organizations: members and agents are blocked until reactivated.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  departments Department[]
  agents      Agent[]

  @@map("organizations")
}

model Membership {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id                   String   @id
  tokenHash            String   @unique @map("token_hash")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Department {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String
  /// Lower-cased, whitespace-collapsed name: enforces case-insensitive uniqueness per org.
  nameKey        String   @map("name_key")
  description    String   @default("")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       Agent[]

  @@unique([organizationId, nameKey])
  @@index([organizationId, createdAt])
  @@map("departments")
}

enum AgentStatus {
  ONLINE
  WORKING
  IDLE
  WAITING
  FAILED
  OFFLINE
  DISCONNECTED
}

enum ConnectionType {
  SDK
  REST_API
  WEBHOOK
  MCP
  API_INTEGRATION
  CUSTOM
}

enum EndpointAuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC
}

enum CapabilityRule {
  ALLOWED
  DENIED
  APPROVAL_REQUIRED
}

/// A connected AI agent. Permanent `agt_` id; every event it reports is tied to its org and department.
model Agent {
  id                   String           @id
  organizationId       String           @map("organization_id")
  departmentId         String           @map("department_id")
  name                 String
  nameKey              String           @map("name_key")
  description          String           @default("")
  provider             String
  model                String
  connectionType       ConnectionType   @map("connection_type")
  endpointUrl          String?          @map("endpoint_url")
  authType             EndpointAuthType @default(NONE) @map("auth_type")
  authHeaderName       String?          @map("auth_header_name")
  /// OFFLINE until the agent reports a heartbeat (Phase 4).
  status               AgentStatus      @default(OFFLINE)
  lastHeartbeatAt      DateTime?        @map("last_heartbeat_at") @db.Timestamptz(3)
  lastActiveAt         DateTime?        @map("last_active_at") @db.Timestamptz(3)
  connectionVerifiedAt DateTime?        @map("connection_verified_at") @db.Timestamptz(3)
  createdById          String?          @map("created_by_id")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Restrict: a department with agents cannot be deleted.
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  credential   AgentCredential?
  apiKeys      AgentApiKey[]
  capabilities AgentCapability[]
  tasks        Task[]

  @@unique([organizationId, nameKey])
  @@index([organizationId, departmentId])
  @@index([organizationId, status])
  @@map("agents")
}

/// Endpoint credential, AES-256-GCM encrypted (AAD binds it to org + agent). Never returned to clients.
model AgentCredential {
  id             String   @id
  organizationId String   @map("organization_id")
  agentId        String   @unique @map("agent_id")
  ciphertext     String
  iv             String
  authTag        String   @map("auth_tag")
  keyVersion     Int      @default(1) @map("key_version")
  /// Display-only hint, e.g. "••••a1b2".
  hint           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("agent_credentials")
}

/// Key the agent uses to report events (Phase 4). Only a SHA-256 hash is stored; shown once.
model AgentApiKey {
  id             String    @id
  organizationId String    @map("organization_id")
  agentId        String    @map("agent_id")
  prefix         String
  keyHash        String    @unique @map("key_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId])
  @@map("agent_api_keys")
}

/// What an agent may do: allowed, denied, or allowed only after human approval.
model AgentCapability {
  id             String         @id
  organizationId String         @map("organization_id")
  agentId        String         @map("agent_id")
  key            String
  label          String
  rule           CapabilityRule
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, key])
  @@index([organizationId])
  @@map("agent_capabilities")
}

enum TaskStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionEventType {
  TASK_STARTED
  TASK_COMPLETED
  TASK_FAILED
  TASK_CANCELLED
  LLM_CALL
  TOOL_CALL
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  LOG
}

/// A unit of work an agent performs. Token counters are maintained incrementally
/// from ingested events (traceable to execution_events.task_id).
model Task {
  id             String     @id
  organizationId String     @map("organization_id")
  agentId        String     @map("agent_id")
  /// Department at the time the task ran (history stays put if the agent moves).
  departmentId   String     @map("department_id")
  name           String
  description    String     @default("")
  status         TaskStatus @default(RUNNING)
  startedAt      DateTime   @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  durationMs     Int?       @map("duration_ms")
  inputTokens    BigInt     @default(0) @map("input_tokens")
  outputTokens   BigInt     @default(0) @map("output_tokens")
  cachedTokens   BigInt     @default(0) @map("cached_tokens")
  llmCalls       Int        @default(0) @map("llm_calls")
  toolCalls      Int        @default(0) @map("tool_calls")
  /// Small result summary the agent chose to send (size-limited; see docs/SECURITY.md).
  result         Json?
  error          String?
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  agent      Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions Execution[]
  events     ExecutionEvent[]

  @@index([organizationId, startedAt(sort: Desc)])
  @@index([organizationId, agentId, startedAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("tasks")
}

/// One run (attempt) of a task.
model Execution {
  id             String     @id
  organizationId String     @map("organization_id")
  agentId        String     @map("agent_id")
  taskId         String     @map("task_id")
  status         TaskStatus @default(RUNNING)
  startedAt      DateTime   @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)

  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events ExecutionEvent[]

  @@index([organizationId, taskId])
  @@map("executions")
}

/// Immutable record of something an agent reported. Unique per (organization, idempotency key):
/// a retried event never creates a second row, so tokens/activity are never double-counted.
model ExecutionEvent {
  id             String             @id
  organizationId String             @map("organization_id")
  agentId        String             @map("agent_id")
  departmentId   String             @map("department_id")
  taskId         String?            @map("task_id")
  executionId    String?            @map("execution_id")
  type           ExecutionEventType
  idempotencyKey String             @map("idempotency_key")
  /// SHA-256 of the canonical payload — reusing a key with a different payload is rejected.
  payloadHash    String             @map("payload_hash")
  occurredAt     DateTime           @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  provider       String?
  model          String?
  inputTokens    Int                @default(0) @map("input_tokens")
  outputTokens   Int                @default(0) @map("output_tokens")
  cachedTokens   Int                @default(0) @map("cached_tokens")
  latencyMs      Int?               @map("latency_ms")
  toolName       String?            @map("tool_name")
  success        Boolean?
  /// Short human-readable line for activity feeds (never prompts/arguments).
  summary        String             @default("")
  metadata       Json               @default("{}")

  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedAt(sort: Desc)])
  @@index([organizationId, agentId, occurredAt(sort: Desc)])
  @@index([taskId, occurredAt])
  @@map("execution_events")
}

enum InquiryType {
  SERVICE
  DEMO
}

/// Public website enquiries (Velorex Studio service requests, AgentOS demo requests).
/// Not tenant-owned. Stored before emailing so no request is lost if delivery fails.
model Inquiry {
  id             String      @id
  type           InquiryType
  name           String
  email          String
  company        String      @default("")
  phone          String      @default("")
  service        String      @default("")
  budget         String      @default("")
  timeline       String      @default("")
  teamSize       String      @default("") @map("team_size")
  message        String      @default("")
  emailDelivered Boolean     @default(false) @map("email_delivered")
  emailError     String?     @map("email_error")
  handledAt      DateTime?   @map("handled_at") @db.Timestamptz(3)
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([type, createdAt(sort: Desc)])
  @@map("inquiries")
}

// Immutable. organization_id is null only for pre-tenant events (signup/login).
model AuditLog {
  id             String   @id
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}

/// Platform price list, managed by Velorex admins. USD per 1M tokens. A price is never edited
/// in place: changing it adds a row with the next `version`, effective from a given time.
model ModelPrice {
  id            String   @id
  /// Normalised "provider/model" key used for matching events (see features/usage/pricing.ts).
  priceKey      String   @map("price_key")
  provider      String
  model         String
  version       Int
  inputPerMtok  Decimal  @map("input_per_mtok") @db.Decimal(12, 6)
  outputPerMtok Decimal  @map("output_per_mtok") @db.Decimal(12, 6)
  cachedPerMtok Decimal  @map("cached_per_mtok") @db.Decimal(12, 6)
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  note          String   @default("")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([priceKey, version])
  @@index([priceKey, effectiveFrom(sort: Desc)])
  @@map("model_prices")
}

/// Cost of one LLM call, written with the event (append-only). `pricingVersion` null = no price
/// was known for the model at that time (cost 0, "unpriced"); it is priced later when a
/// matching price is added — already-priced records never change.
model CostRecord {
  id             String   @id
  organizationId String   @map("organization_id")
  eventId        String   @unique @map("event_id")
  agentId        String   @map("agent_id")
  departmentId   String   @map("department_id")
  taskId         String?  @map("task_id")
  priceKey       String   @map("price_key")
  provider       String
  model          String
  /// Calendar day in the organization's timezone when the call happened.
  day            DateTime @db.Date
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  cachedTokens   Int      @map("cached_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(24, 12)
  priceId        String?  @map("price_id")
  pricingVersion Int?     @map("pricing_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, day])
  @@index([priceKey, pricingVersion])
  @@map("cost_records")
}

/// Pre-aggregated usage per (organization, day, agent, department, provider, model).
/// Dashboards and the Costs page read this instead of scanning events.
model UsageDaily {
  organizationId String   @map("organization_id")
  day            DateTime @db.Date
  agentId        String   @map("agent_id")
  departmentId   String   @map("department_id")
  priceKey       String   @map("price_key")
  provider       String
  model          String
  llmCalls       Int      @default(0) @map("llm_calls")
  unpricedCalls  Int      @default(0) @map("unpriced_calls")
  inputTokens    BigInt   @default(0) @map("input_tokens")
  outputTokens   BigInt   @default(0) @map("output_tokens")
  cachedTokens   BigInt   @default(0) @map("cached_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(24, 12)

  @@id([organizationId, day, agentId, departmentId, priceKey])
  @@index([organizationId, day])
  @@map("usage_daily")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalRisk {
  LOW
  MEDIUM
  HIGH
}

/// Who/what decided: a person, the agent's permission rule, or the system (task ended).
enum ApprovalDecisionSource {
  HUMAN
  POLICY
  SYSTEM
}

/// A human-in-the-loop request raised by an agent (`approval.requested`). Decided by a person
/// (owner/admin/manager), or automatically by the agent's capability rule (ALLOWED / DENIED).
model Approval {
  id             String                  @id
  organizationId String                  @map("organization_id")
  agentId        String                  @map("agent_id")
  departmentId   String                  @map("department_id")
  taskId         String?                 @map("task_id")
  /// The approval.requested event (one approval per event).
  eventId        String                  @unique @map("event_id")
  action         String
  reason         String                  @default("")
  risk           ApprovalRisk            @default(MEDIUM)
  /// Agent capability the action matched (e.g. "send_external_email"), if any.
  capabilityKey  String?                 @map("capability_key")
  status         ApprovalStatus          @default(PENDING)
  decisionSource ApprovalDecisionSource? @map("decision_source")
  decidedById    String?                 @map("decided_by_id")
  decisionNote   String                  @default("") @map("decision_note")
  requestedAt    DateTime                @map("requested_at") @db.Timestamptz(3)
  decidedAt      DateTime?               @map("decided_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  decidedBy User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, requestedAt(sort: Desc)])
  @@index([organizationId, agentId, status])
  @@index([taskId])
  @@map("approvals")
}
